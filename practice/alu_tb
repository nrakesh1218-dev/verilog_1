`timescale 1ns / 1ps

module tb_alu;

    reg [3:0] a;
    reg [3:0] b;
    reg [2:0] sel;
    wire [7:0] y;

    alu uut (
        .a(a), 
        .b(b), 
        .sel(sel), 
        .y(y)
    );

    initial begin
        a = 4'd6;  b = 4'd3;  sel = 3'b000; #10;
        a = 4'd6;  b = 4'd3;  sel = 3'b001; #10;
        a = 4'd6;  b = 4'd3;  sel = 3'b010; #10;
        a = 4'd6;  b = 4'd3;  sel = 3'b011; #10;
        a = 4'd6;  b = 4'd3;  sel = 3'b100; #10;
        a = 4'd6;  b = 4'd3;  sel = 3'b101; #10;
    end

endmodule
