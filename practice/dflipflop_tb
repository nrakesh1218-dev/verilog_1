`timescale 1ns / 1ps

module tb_dflipflop;

    reg clk;
    reg d;
    wire q;

    dflipflop uut (
        .clk(clk), 
        .d(d), 
        .q(q)
    );

    initial begin
        clk = 1'b0;
        forever #5 clk = ~clk;
    end

    initial begin
        d = 1'b0; #12;
        d = 1'b1; #10;
        d = 1'b0; #15;
        d = 1'b1; #12;
        d = 1'b0; #10;
    end

endmodule
