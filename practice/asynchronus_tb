`timescale 1ns / 1ps

module tb_asynchronous;

    reg clk;
    reg rst;
    wire [3:0] q;

    asynchronous uut (
        .clk(clk), 
        .rst(rst), 
        .q(q)
    );

    initial begin
        clk = 1'b0;
        forever #5 clk = ~clk;
    end

    initial begin
        rst = 1'b1; #12;
        rst = 1'b0; #40;
        rst = 1'b1; #10;
        rst = 1'b0; #30;
    end

endmodule
