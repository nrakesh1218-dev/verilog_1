`timescale 1ns / 1ps

module tb_counter_4bit;

    reg clk;
    reg rst_n;
    reg enable;
    wire [3:0] count;

    counter_4bit uut (
        .clk(clk), 
        .rst_n(rst_n), 
        .enable(enable), 
        .count(count)
    );

    initial begin
        clk = 1'b0;
        forever #5 clk = ~clk;
    end

    initial begin
        rst_n = 1'b0; enable = 1'b0; #12;
        rst_n = 1'b1; enable = 1'b1; #50;
        enable = 1'b0; #20;
        enable = 1'b1; #50;
        rst_n = 1'b0; #10;
        rst_n = 1'b1; #30;
    end

endmodule
