`timescale 1ns / 1ps

module tb_multiplier;

    reg [3:0] a;
    reg [3:0] b;
    wire [7:0] y;

    multiplier uut (
        .a(a), 
        .b(b), 
        .y(y)
    );

    initial begin
        a = 4'd2; b = 4'd3;  #10;
        a = 4'd5; b = 4'd5;  #10;
        a = 4'd7; b = 4'd4;  #10;
        a = 4'd8; b = 4'd9;  #10;
        a = 4'd15; b = 4'd15; #10;
    end

endmodule
