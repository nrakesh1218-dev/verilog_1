`timescale 1ns / 1ps

module tb_demux;

    reg in;
    reg [1:0] sel;
    wire [3:0] y;

    demux uut (
        .in(in), 
        .sel(sel), 
        .y(y)
    );

    initial begin
        in = 1'b1; sel = 2'b00; #10;
        in = 1'b1; sel = 2'b01; #10;
        in = 1'b1; sel = 2'b10; #10;
        in = 1'b1; sel = 2'b11; #10;
        in = 1'b0; sel = 2'b00; #10;
    end

endmodule
