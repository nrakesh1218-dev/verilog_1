`timescale 1ns / 1ps

module tb_multiplier_8bit;

    reg [7:0] a;
    reg [7:0] b;
    wire [15:0] y;

    multiplier_8bit uut (
        .a(a), 
        .b(b), 
        .y(y)
    );

    initial begin
        a = 8'd10;  b = 8'd20;  #10;
        a = 8'd50;  b = 8'd30;  #10;
        a = 8'd100; b = 8'd5;   #10;
        a = 8'd200; b = 8'd100; #10;
        a = 8'd255; b = 8'd255; #10;
    end

endmodule
