`timescale 1ns / 1ps

module tb_mux_4to1;

    reg [1:0] sel;
    reg [3:0] d;
    wire y;

    mux_4to1 uut (
        .sel(sel), 
        .d(d), 
        .y(y)
    );

    initial begin
        d = 4'b1010; 
        sel = 2'b00; #10;
        sel = 2'b01; #10;
        sel = 2'b10; #10;
        sel = 2'b11; #10;
        
        d = 4'b1100;
        sel = 2'b00; #10;
        sel = 2'b01; #10;
        sel = 2'b10; #10;
        sel = 2'b11; #10;
    end

endmodule
