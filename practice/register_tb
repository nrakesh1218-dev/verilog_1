`timescale 1ns / 1ps

module tb_register;

    reg clk;
    reg rst;
    reg [3:0] d;
    wire [3:0] q;

    register uut (
        .clk(clk), 
        .rst(rst), 
        .d(d), 
        .q(q)
    );

    initial begin
        clk = 1'b0;
        forever #5 clk = ~clk;
    end

    initial begin
        rst = 1'b1; d = 4'b0000; #12;
        rst = 1'b0; d = 4'b1010; #10;
        d = 4'b1100; #10;
        d = 4'b1111; #10;
        rst = 1'b1; #5;
        rst = 1'b0; d = 4'b0101; #10;
    end

endmodule
