`timescale 1ns / 1ps

module comparator_4bit_tb;
    reg [3:0] a;
    reg [3:0] b;
    wire greater;
    wire equal;
    wire lesser;

    comparator_4bit uut (
        .a(a),
        .b(b),
        .greater(greater),
        .equal(equal),
        .lesser(lesser)
    );

    initial begin
        $dumpfile("comparator_4bit.vcd");
        $dumpvars(0, comparator_4bit_tb);

        a = 4'd5; b = 4'd5; #10;
        a = 4'd8; b = 4'd3; #10;
        a = 4'd2; b = 4'd9; #10;
        a = 4'd12; b = 4'd10; #10;
        a = 4'd0; b = 4'd15; #10;
    end
endmodule
