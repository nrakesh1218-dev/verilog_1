`timescale 1ns / 1ps

module mealy_sequence_detector_11 (
    input clk,
    input rst,
    input in,
    output reg detected
);
    
    parameter S0 = 1'b0,
              S1 = 1'b1;

    reg state, next_state;

    always @(posedge clk or posedge rst) begin
        if (rst)
            state <= S0;
        else
            state <= next_state;
    end

    always @(*) begin
        detected = 1'b0;
        case (state)
            S0: begin
                if (in) begin
                    next_state = S1;
                    detected   = 1'b0;
                end else begin
                    next_state = S0;
                    detected   = 1'b0;
                end
            end
            S1: begin
                if (in) begin
                    next_state = S1;
                    detected   = 1'b1; 
                end else begin
                    next_state = S0;
                    detected   = 1'b0;
                end
            end
            default: begin
                next_state = S0;
                detected   = 1'b0;
            end
        endcase
    end
endmodule
