module moore_fsm (
    input clk,
    input reset,
    input in,
    output reg out
);

    parameter S0 = 2'b00, 
              S1 = 2'b01, 
              S2 = 2'b10;
              
    reg [1:0] current_state, next_state;

    always @(posedge clk or posedge reset) begin
        if (reset)
            current_state <= S0;
        else
            current_state <= next_state;
    end

    always @(*) begin
        case (current_state)
            S0: next_state = in ? S1 : S0;
            S1: next_state = in ? S2 : S0;
            S2: next_state = S0;
            default: next_state = S0;
        endcase
    end

    always @(current_state) begin
        case (current_state)
            S0: out = 1'b0;
            S1: out = 1'b0;
            S2: out = 1'b1;
            default: out = 1'b0;
        endcase
    end

endmodule
