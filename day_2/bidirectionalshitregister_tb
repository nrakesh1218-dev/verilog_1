`timescale 1ns / 1ps

module bidirectional_shift_register_tb;
    reg clk;
    reg rst;
    reg dir;
    reg si;
    wire [3:0] po;

    bidirectional_shift_register uut (
        .clk(clk),
        .rst(rst),
        .dir(dir),
        .si(si),
        .po(po)
    );

    initial begin
        clk = 1'b0;
        forever #5 clk = ~clk;
    end

    initial begin
        $dumpfile("bidirectional_shift_register.vcd");
        $dumpvars(0, bidirectional_shift_register_tb);

        rst = 1'b1; dir = 1'b1; si = 1'b0; #12;
        rst = 1'b0; si = 1'b1; #10;
        si = 1'b0; #10;
        si = 1'b1; #10;
        dir = 1'b0; si = 1'b0; #10;
        si = 1'b1; #10;
    end
endmodule
