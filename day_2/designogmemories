`timescale 1ns / 1ps

module rom_memory (
    input [3:0] addr,
    output reg [7:0] dout
);
    always @(*) begin
        case (addr)
            4'd0:  dout = 8'hA1;
            4'd1:  dout = 8'hB2;
            4'd2:  dout = 8'hC3;
            4'd3:  dout = 8'hD4;
            4'd4:  dout = 8'hE5;
            4'd5:  dout = 8'hF6;
            4'd6:  dout = 8'h17;
            4'd7:  dout = 8'h28;
            4'd8:  dout = 8'h39;
            4'd9:  dout = 8'h4A;
            4'd10: dout = 8'h5B;
            4'd11: dout = 8'h6C;
            4'd12: dout = 8'h7D;
            4'd13: dout = 8'h8E;
            4'd14: dout = 8'h9F;
            4'd15: dout = 8'h00;
            default: dout = 8'hFF;
        endcase
    end
endmodule
